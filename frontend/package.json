{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "test -n \"$NEXT_PUBLIC_TURNSTILE_SITE_KEY\" || { echo 'NEXT_PUBLIC_TURNSTILE_SITE_KEY ausente' >&2; exit 1; }; next build && grep -rqsF \"$NEXT_PUBLIC_TURNSTILE_SITE_KEY\" out && ! grep -rqs localhost:8000 out && wrangler deploy"
  },
  "dependencies": {
    "daisyui": "^5.5.19",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.0"
  }
}
