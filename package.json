{
  "name": "verifica",
  "private": true,
  "version": "0.1.0",
  "description": "Verificador de fatos com FastAPI + Next.js (Gemini AI + RAG).",
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "node scripts/backend.mjs setup",
    "setup:frontend": "cd frontend && npm install",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/backend.mjs dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start:frontend": "cd frontend && npm run start",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}