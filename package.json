{
  "name": "verifica",
  "private": true,
  "version": "0.1.0",
  "description": "Verificador de indícios de desinformação: FastAPI + Next.js, Gemma 4 via OpenRouter, Cloudflare Workers.",
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend",
    "setup:backend": "node scripts/backend.mjs setup",
    "setup:frontend": "cd frontend && npm install",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/backend.mjs dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/backend.mjs test",
    "test:frontend": "cd frontend && npm test",
    "build:frontend": "cd frontend && npm run build",
    "deploy:frontend": "cd frontend && npm run deploy",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}