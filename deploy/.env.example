# Copie para deploy/.env no servidor com chmod 600. O .env real nunca vai para o git.
# O backend recusa valores que comecem com "troque-".
OPENROUTER_API_KEY=troque-pela-chave-dedicada-verifica
MODEL_NAME=google/gemma-4-26b-a4b-it:free
GATEWAY_KEY=troque-por-32-bytes-aleatorios-base64url-xxxxxxxxxxxx
IP_HASH_KEY=troque-por-32-bytes-aleatorios-base64url-xxxxxxxxxxxx
QUOTA_GLOBAL_DAILY=200
QUOTA_PER_IP_DAILY=10
LLM_PER_MINUTE=15
LLM_MAX_CONCURRENCY=2
CACHE_TTL_HOURS=24
TUNNEL_TOKEN=troque-pelo-token-do-tunel-verifica
