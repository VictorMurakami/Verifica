# =============================================================
# Verifica — variáveis de ambiente (referência geral)
# =============================================================
# Copie este mesmo arquivo para os dois serviços:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
# Cada serviço lê apenas as variáveis que lhe são relevantes.
# Nunca comite os .env reais.
# -------------------------------------------------------------

# ---------- Backend (FastAPI) ----------
# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua-chave-aqui

# Nome do modelo Gemini a ser utilizado
# Ex.: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
MODEL_NAME=gemini-2.5-flash

# ---------- Frontend (Next.js) ----------
# URL pública da API consumida pelo frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
